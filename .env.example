# Supabase Postgres (pooled runtime connection + direct connection for Prisma schema changes)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Generate independent random values (at least 32 characters each) before deploying.
JWT_SECRET="replace-with-a-long-random-access-token-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-token-secret"
CERT_SECRET="replace-with-a-long-random-certificate-signing-secret"
ADMIN_EMAIL="creatorsports81@gmail.com"
ADMIN_PASSWORD="replace-with-a-unique-strong-admin-password"

# Supabase Storage; keep the service-role key server-only. Create a public bucket
# named campuscred-assets, or set SUPABASE_STORAGE_BUCKET to another bucket name.
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-the-service-role-key"
SUPABASE_STORAGE_BUCKET="campuscred-assets"

# Public base URL used in links/metadata (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local development defaults only. Configure a real provider for production.
EMAIL_PROVIDER="console"
SMS_PROVIDER="console"
