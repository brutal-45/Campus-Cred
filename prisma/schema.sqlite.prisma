generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── USER & AUTH ───

model User {
  id                 String     @id @default(cuid())
  fullName           String
  email              String     @unique
  phone              String?
  passwordHash       String
  role               String     @default("student") // student, company, mentor, college, admin
  college            String?
  city               String?
  state              String?
  degree             String?
  branch             String?
  year               String?
  profilePhoto       String?
  bio                String?
  isVerified         Boolean    @default(false)
  streakDays         Int        @default(0)
  lastActiveAt       DateTime?
  points             Int        @default(0)
  campusCredScore    Int        @default(0)
  level              String     @default("Starter")
  referralCode       String?    @unique
  referredBy         String?
  portfolioSlug      String?    @unique
  skills             String?    // JSON array
  socialLinks        String?    // JSON object
  twoFactorEnabled   Boolean    @default(false)
  twoFactorSecret    String?
  twoFactorMethod    String?
  campusCredUsername String?    @unique
  deletionRequestedAt DateTime?
  resumeData         String?    // JSON object for resume builder
  isAmbassador       Boolean    @default(false)
  ambassadorLevel    String?    // "bronze", "silver", "gold", "platinum"
  loginAttempts      Int        @default(0)
  lockedUntil        DateTime?
  deviceFingerprint  String?    // Last known device
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  googleId           String?
  githubId           String?
  linkedinId         String?
  oauthAvatar        String?

  submissions        Submission[]
  reviewedSubmissions Submission[]  @relation("ReviewerSubmissions")
  peerReviewsGiven   PeerReview[]  @relation("ReviewerPeerReviews")
  certificates       Certificate[]
  notifications      Notification[]
  internshipApps     InternshipApplicant[]
  createdTasks       Task[]
  journeyLogs        JourneyLog[]
  mentorshipSessionsAsStudent MentorshipSession[] @relation("StudentSessions")
  skillBadges        StudentBadge[]
  sentMessages       Message[]   @relation("SentMessages")
  conversationParticipants ConversationParticipant[]
  company            Company?
  mentor             Mentor?
  collegeOrg         College?
  sessions           Session[]
  passwordResets     PasswordReset[]
  loginHistory       LoginHistory[]
  ambassadorActivities AmbassadorActivity[]
  referralsMade      Referral[]  @relation("Referrer")
  blogPosts          BlogPost[]
}

// ─── TASKS & SUBMISSIONS ───

model Task {
  id              String      @id @default(cuid())
  title           String
  description     String
  degree          String
  branch          String
  difficulty      String      @default("Medium")
  points          Int         @default(10)
  deadline        DateTime
  taskKitUrl      String?
  category        String?     // development, design, marketing, data, writing, research
  estimatedHours  String?
  isActive        Boolean     @default(true)
  isChallenge     Boolean     @default(false) // true for daily challenges
  challengeDate   DateTime?   // Date for daily challenges
  companyId       String?     // If posted by a company
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  submissions     Submission[]
  certificates    Certificate[]
  creator         User?       @relation(fields: [createdById], references: [id])
  company         Company?    @relation(fields: [companyId], references: [id])
}

model Submission {
  id           String     @id @default(cuid())
  studentId    String
  taskId       String
  fileUrl      String?
  externalLink String?
  description  String?
  status       String     @default("Pending")
  feedback     String?
  rating       Int?
  reviewedBy   String?
  isEarly      Boolean    @default(false)
  submittedAt  DateTime   @default(now())
  reviewedAt   DateTime?

  student      User       @relation(fields: [studentId], references: [id])
  task         Task       @relation(fields: [taskId], references: [id])
  certificate  Certificate?
  reviewer     User?      @relation("ReviewerSubmissions", fields: [reviewedBy], references: [id])
  peerReviews  PeerReview[]
}

model PeerReview {
  id           String   @id @default(cuid())
  submissionId String
  reviewerId   String
  rating       Int      // 1-5
  feedback     String
  createdAt    DateTime @default(now())

  submission   Submission @relation(fields: [submissionId], references: [id])
  reviewer     User       @relation("ReviewerPeerReviews", fields: [reviewerId], references: [id])
}

// ─── CERTIFICATES ───

model Certificate {
  id            String      @id @default(cuid())
  certificateId String      @unique
  studentId     String
  taskId        String
  submissionId  String      @unique
  studentName   String
  degree        String
  branch        String
  taskTitle     String
  college       String?
  city          String?
  state         String?
  skills        String?
  level         String      @default("Starter")
  issuedDate    DateTime    @default(now())
  qrCodeUrl     String?
  pdfUrl        String?
  certificateImageUrl String?
  thumbnailUrl  String?
  hash          String?
  isValid       Boolean     @default(true)

  student       User        @relation(fields: [studentId], references: [id])
  task          Task        @relation(fields: [taskId], references: [id])
  submission    Submission  @relation(fields: [submissionId], references: [id])
}

// ─── COMPANIES ───

model Company {
  id            String       @id @default(cuid())
  userId        String       @unique
  companyName   String
  slug          String       @unique // URL-friendly name
  email         String
  phone         String?
  website       String?
  industry      String?
  description   String?
  logoUrl       String?
  coverUrl      String?
  location      String?
  city          String?
  state         String?
  employeeCount String?      // "1-10", "11-50", "51-200", "201-500", "500+"
  foundedYear   Int?
  isVerified    Boolean      @default(false)
  isFeatured    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  internships   Internship[]
  tasks         Task[]
  user          User         @relation(fields: [userId], references: [id])
}

// ─── MENTORS ───

model Mentor {
  id            String   @id @default(cuid())
  userId        String   @unique
  expertise     String?  // JSON array
  experience    String?
  designation   String?
  organization  String?
  bio           String?
  isVerified    Boolean  @default(false)
  isAvailable   Boolean  @default(true)
  rating        Float    @default(0)
  totalReviews  Int      @default(0)
  hourlyRate    Int?      // In INR
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
  sessions      MentorshipSession[]
}

// ─── COLLEGES ───

model College {
  id            String   @id @default(cuid())
  userId        String   @unique
  collegeName   String
  slug          String?  @unique
  address       String?
  state         String?
  city          String?
  naacRating    String?
  nirfRank      Int?
  isPartner     Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  website       String?
  logoUrl       String?
  totalStudents Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
}

// ─── INTERNSHIPS ───

model Internship {
  id          String               @id @default(cuid())
  companyId   String
  title       String
  slug        String?              @unique
  description String
  requirements String?             // JSON array
  branches    String               // JSON array
  degrees     String               // JSON array
  duration    String?
  isPaid      Boolean              @default(false)
  stipend     String?
  location    String?
  isRemote    Boolean              @default(false)
  deadline    DateTime
  status      String               @default("Open")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  company     Company              @relation(fields: [companyId], references: [id])
  applicants  InternshipApplicant[]
}

model InternshipApplicant {
  id            String      @id @default(cuid())
  internshipId  String
  studentId     String
  status        String      @default("Applied")
  coverLetter   String?
  appliedAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  internship    Internship  @relation(fields: [internshipId], references: [id])
  student       User        @relation(fields: [studentId], references: [id])
}

// ─── JOURNEY LOGS ───

model JourneyLog {
  id          String   @id @default(cuid())
  studentId   String
  type        String   // "task_completed", "certificate_earned", "internship_started", "internship_completed", "milestone"
  title       String
  description String?
  metadata    String?  // JSON object with extra data
  createdAt   DateTime @default(now())

  student     User     @relation(fields: [studentId], references: [id])
}

// ─── MENTORSHIP ───

model MentorshipSession {
  id          String   @id @default(cuid())
  studentId   String
  mentorId    String
  topic       String
  status      String   @default("Scheduled") // Scheduled, In Progress, Completed, Cancelled
  scheduledAt DateTime
  duration    Int?     // In minutes
  notes       String?
  rating      Int?     // 1-5 rating by student
  feedback    String?
  meetLink    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     User     @relation("StudentSessions", fields: [studentId], references: [id])
  mentor      Mentor   @relation(fields: [mentorId], references: [id])
}

// ─── SKILL BADGES ───

model SkillBadge {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?  // Emoji or icon name
  category    String?  // "development", "design", etc.
  criteria    String?  // JSON object with criteria
  createdAt   DateTime @default(now())

  studentBadges StudentBadge[]
}

model StudentBadge {
  id          String     @id @default(cuid())
  studentId   String
  badgeId     String
  earnedAt    DateTime   @default(now())

  student     User       @relation(fields: [studentId], references: [id])
  badge       SkillBadge @relation(fields: [badgeId], references: [id])

  @@unique([studentId, badgeId])
}

// ─── NOTIFICATIONS ───

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  message   String
  type      String   @default("info")
  link      String?  // URL to navigate to
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

// ─── MESSAGES ───

model Conversation {
  id        String   @id @default(cuid())
  type      String   @default("direct") // direct, group
  name      String?  // For group conversations
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
}

// ─── LEADERBOARD SNAPSHOTS ───

model LeaderboardSnapshot {
  id         String   @id @default(cuid())
  branch     String
  date       DateTime
  rankings   String   // JSON array of {studentId, rank, score}
  createdAt  DateTime @default(now())

  @@unique([branch, date])
}

// ─── AMBASSADOR PROGRAM ───

model AmbassadorActivity {
  id          String   @id @default(cuid())
  userId      String
  activity    String   // "referral", "event", "social_post", "campus_drive"
  description String?
  points      Int      @default(0)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

// ─── REFERRALS ───

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referredEmail String
  referredId  String?  // Filled when referred user registers
  status      String   @default("Sent") // Sent, Registered, Completed
  createdAt   DateTime @default(now())

  referrer    User     @relation("Referrer", fields: [referrerId], references: [id])
}

// ─── OTP RECORDS ───

model OtpVerification {
  id          String   @id @default(cuid())
  target      String
  type        String   // "phone" or "email"
  otp         String
  purpose     String   // "registration", "login", "forgot-password", "2fa", "verification"
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  isVerified  Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([target, type, purpose])
  @@index([expiresAt])
}

// ─── SESSION & AUTH ───

model Session {
  id             String   @id @default(cuid())
  userId         String
  refreshToken   String   @unique
  deviceInfo     String?
  deviceName     String?
  ipAddress      String?
  location       String?
  userAgent      String?
  fingerprint    String?  // Device fingerprint
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastAccessedAt DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id           String    @id @default(cuid())
  userId       String
  ipAddress    String?
  device       String?
  location     String?
  fingerprint  String?
  success      Boolean   @default(true)
  failureReason String?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── BLOG ───

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String   // Markdown or rich text
  coverImage  String?
  category    String?  // "career", "technology", "education", "company", "tips"
  tags        String?  // JSON array
  authorId    String
  status      String   @default("Draft") // Draft, Published, Archived
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id])
}

// ─── ANALYTICS ───

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  event      String   // "page_view", "task_completed", "certificate_earned", etc.
  properties String?  // JSON object
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

// ─── FRAUD LOGS ───

model FraudLog {
  id          String   @id @default(cuid())
  userId      String?
  type        String   // "suspicious_login", "multiple_accounts", "plagiarism", "abuse"
  severity    String   @default("medium") // low, medium, high, critical
  description String
  metadata    String?  // JSON
  ipAddress   String?
  resolved    Boolean  @default(false)
  resolvedBy  String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}

// ─── CITY DATABASE ───

model CityDatabase {
  id        String   @id @default(cuid())
  name      String
  state     String
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  @@index([state])
}
